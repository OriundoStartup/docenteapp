{
  "version": 2,
  "buildCommand": "./gradlew :app:webApp:wasmJsBrowserDistribution",
  "outputDirectory": "app/webApp/build/dist/wasmJs/productionExecutable",
  "framework": null,
  "headers": [
    {
      "source": "/(.*).wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
